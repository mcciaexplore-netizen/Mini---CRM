# Copy to .env.local. All database and auth secrets stay on the server.
# Neon console > Connect > pooled PostgreSQL connection string (keep sslmode=require).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional direct URL for migrations; must use the SAME database role and database.
DIRECT_DATABASE_URL=
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional verified email / password reset delivery through Resend.
# With both configured, sign-up requires email verification.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Google Calendar OAuth integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional Sheets integration: server spreadsheet belongs to exactly one business.
GOOGLE_SHEETS_ORGANIZATION_ID=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
